# Backend (NestJS) configuration.
#
# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Only this template is.
# Values are read via ConfigService (see src/main.ts); anything set in your
# shell environment overrides what is written here.

# Port the API listens on. The frontend expects 3000 by default.
PORT=3000

# Origin allowed by CORS - the Next.js dev server.
# Only needed for client-side fetches; Server Components don't use CORS.
FRONTEND_URL=http://localhost:4200

# Neon Postgres. Get both strings from the Neon console, or run:
#     npx neonctl connection-string --project-id <id> --pooled   # DATABASE_URL
#     npx neonctl connection-string --project-id <id>            # DATABASE_URL_UNPOOLED
#
# Two endpoints, and using the wrong one is the classic Neon mistake. The pooled
# host carries "-pooler" and routes through PgBouncer, which discards prepared
# statements between transactions. That breaks migration tooling, so:
#
#   DATABASE_URL           pooled   - the running application
#   DATABASE_URL_UNPOOLED  direct   - migrations and the catalogue import script
#
# Neon scales to zero, so the first query after an idle period is slow (~1.5s).
# Do not write tests that assume a fast first connection.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth JWKS endpoint. The trust anchor for NeonAuthGuard: a token whose
# signature validates against this could only have been issued by our own auth
# instance. The guard also derives the expected `iss` and `aud` from this URL's
# origin, which is why there is one variable here rather than three that could
# drift apart.
#
#     npx neonctl neon-auth status --project-id <id>
#
# There is no ConfigModule validationSchema, so leaving this unset does not fail
# at boot. The app starts fine and then 500s on the first authenticated request.
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# TMDB v4 read access token, for the Picker catalogue import. Get one at
# themoviedb.org under Settings > API. Sent as `Authorization: Bearer <token>`,
# never as an `api_key` query parameter, so it stays out of URLs and logs.
#
# Backend-only and tied to a personal TMDB account. Never give it a NEXT_PUBLIC_
# prefix or move it to the frontend: that would inline it into the browser bundle
# and publish it permanently.
TMDB_API_READ_TOKEN=
