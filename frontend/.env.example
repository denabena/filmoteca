# Base URL of the NestJS backend API this frontend calls.
# Read server-side only (the async Server Component in src/app/page.tsx), so it
# has NO NEXT_PUBLIC_ prefix and is never inlined into the browser bundle.
# Never expose secrets via NEXT_PUBLIC_ vars; real secrets live in the team
# secret manager and, for Vercel, in the project's Environment Variables settings.
BACKEND_URL=http://localhost:3000

# Neon Auth (Managed Better Auth). Get the base URL from:
#     npx neonctl neon-auth status --project-id <project-id>
# Generate the cookie secret with:
#     openssl rand -base64 32
#
# Neither variable takes a NEXT_PUBLIC_ prefix. The secret signs session cookies,
# so inlining it into the browser bundle would leak it permanently. The base URL
# is only read by the server-side route handler at src/app/api/auth/[...path].
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-me-with-32-plus-random-characters
